    { "kind": "model", "id": "sample-commando-look:model/dummy", "file": "models/dummy.json" }
  ],
  "client": {
    "module": "client/main.wasm",
    "capabilities": ["render.layer", "render.shader", "world.read"],
    "shaders": ["client/sights.wgsl"]
