{
  "schema_version": 1,
  "script": "slayer.rhai",
  "brick_inputs": [
    { "name": "onCPCapture", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPReset", "targets": ["MiniGame"] },
    { "name": "onCPCapture(Team1)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team2)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team3)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team4)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team5)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team6)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onTeamCheckTrue", "targets": ["Player", "Client", "MiniGame", "OwnerPlayer", "OwnerClient"] },
    { "name": "onTeamCheckFalse", "targets": ["Player", "Client", "MiniGame", "OwnerPlayer", "OwnerClient"] },
    { "name": "onPlayerTouch(Team1)", "targets": ["Player", "Client", "MiniGame"], "follows": "onPlayerTouch" },
    { "name": "onPlayerTouch(Team2)", "targets": ["Player", "Client", "MiniGame"], "follows": "onPlayerTouch" },
    { "name": "onPlayerTouch(Team3)", "targets": ["Player", "Client", "MiniGame"], "follows": "onPlayerTouch" },
    { "name": "onPlayerTouch(Team4)", "targets": ["Player", "Client", "MiniGame"], "follows": "onPlayerTouch" },
    { "name": "onPlayerTouch(Team5)", "targets": ["Player", "Client", "MiniGame"], "follows": "onPlayerTouch" },
    { "name": "onPlayerTouch(Team6)", "targets": ["Player", "Client", "MiniGame"], "follows": "onPlayerTouch" },
    { "name": "onActivate(Team1)", "targets": ["Player", "Client", "MiniGame"], "follows": "onActivate" },
    { "name": "onActivate(Team2)", "targets": ["Player", "Client", "MiniGame"], "follows": "onActivate" },
    { "name": "onActivate(Team3)", "targets": ["Player", "Client", "MiniGame"], "follows": "onActivate" },
    { "name": "onActivate(Team4)", "targets": ["Player", "Client", "MiniGame"], "follows": "onActivate" },
    { "name": "onActivate(Team5)", "targets": ["Player", "Client", "MiniGame"], "follows": "onActivate" },
    { "name": "onActivate(Team6)", "targets": ["Player", "Client", "MiniGame"], "follows": "onActivate" },
    { "name": "onMinigameDeath", "targets": ["Client", "Player(Killer)", "Client(Killer)", "MiniGame"] },
    { "name": "onMinigameJoin", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onMinigameLeave", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onMinigameRoundStart", "targets": ["MiniGame"] },
    { "name": "onMinigameRoundEnd", "targets": ["MiniGame"] }
  ],
  "brick_outputs": [
    { "name": "setTeamControl", "class": "fxDTSBrick", "params": {{out_team_control|event_params}} },
    { "name": "setTeamControlLocked", "class": "fxDTSBrick", "params": {{out_team_control_locked|event_params}} },
    { "name": "addLives", "class": "GameConnection", "params": {{out_add_lives|event_params}} },
    { "name": "addDeaths", "class": "GameConnection", "params": {{out_add_deaths|event_params}} },
    { "name": "addKills", "class": "GameConnection", "params": {{out_add_kills|event_params}} },
    { "name": "setLives", "class": "GameConnection", "params": {{out_set_lives|event_params}} },
    { "name": "setDeaths", "class": "GameConnection", "params": {{out_set_deaths|event_params}} },
    { "name": "setKills", "class": "GameConnection", "params": {{out_set_kills|event_params}} },
    { "name": "joinTeam", "class": "GameConnection", "params": {{out_join_team|event_params}} },
    { "name": "incTimeRemaining", "class": "MiniGame", "params": {{out_inc_time|event_params}} },
    { "name": "setTimeRemaining", "class": "MiniGame", "params": {{out_set_time|event_params}} },
    { "name": "Win", "class": "MiniGame", "params": {{out_win|event_params}} },
    { "name": "checkTeam", "class": "fxDTSBrick", "params": {{out_check_team|event_params}} },
    { "name": "checkTeamCount", "class": "fxDTSBrick", "params": {{out_check_team_count|event_params}} },
    { "name": "StartFlyThrough", "class": "MiniGame", "params": {{out_fly_through|event_params}} },
    { "name": "BottomPrintAll", "class": "Slayer_TeamSO", "params": {{out_team_bottom_print|event_params}} },
    { "name": "CenterPrintAll", "class": "Slayer_TeamSO", "params": {{out_team_center_print|event_params}} },
    { "name": "ChatMsgAll", "class": "Slayer_TeamSO", "params": {{out_team_chat|event_params}} },
    { "name": "RespawnAll", "class": "Slayer_TeamSO", "params": {{out_team_respawn|event_params}} },
    { "name": "IncScore", "class": "Slayer_TeamSO", "params": {{out_team_inc_score|event_params}} }
  ],
  "brick_targets": [
    { "name": "Team(Client)", "class": "Slayer_TeamSO", "from": "Client" },
    { "name": "Team(Brick)", "class": "Slayer_TeamSO", "from": "Self" }
  ],
