  "settings": [
    {
      "key": "mode",
      "title": "Game Mode",
      "category": "Minigame",
      "type": "list",
      "default": "{{dm_class}}",
      "resets": true,
      "items": [
        {
          "value": "{{dm_class}}",
          "name": "{{dm_name}}"
        },
        {
          "value": "{{tdm_class}}",
          "name": "{{tdm_name}}"
        }
      ]
