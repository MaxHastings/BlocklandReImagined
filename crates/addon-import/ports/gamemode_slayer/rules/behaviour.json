{
  "schema_version": 1,
  "script": "slayer.rhai",
  "brick_inputs": [
    { "name": "onCPCapture", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPReset", "targets": ["MiniGame"] },
    { "name": "onCPCapture(Team1)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team2)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team3)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team4)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team5)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onCPCapture(Team6)", "targets": ["Player", "Client", "MiniGame"] },
    { "name": "onTeamCheckTrue", "targets": ["Player", "Client", "MiniGame", "OwnerPlayer", "OwnerClient"] },
    { "name": "onTeamCheckFalse", "targets": ["Player", "Client", "MiniGame", "OwnerPlayer", "OwnerClient"] }
  ],
  "brick_outputs": [
    { "name": "setTeamControl", "class": "fxDTSBrick", "params": {{out_team_control|event_params}} },
    { "name": "setTeamControlLocked", "class": "fxDTSBrick", "params": {{out_team_control_locked|event_params}} },
    { "name": "addLives", "class": "GameConnection", "params": {{out_add_lives|event_params}} },
    { "name": "addDeaths", "class": "GameConnection", "params": {{out_add_deaths|event_params}} },
    { "name": "addKills", "class": "GameConnection", "params": {{out_add_kills|event_params}} },
    { "name": "setLives", "class": "GameConnection", "params": {{out_set_lives|event_params}} },
    { "name": "setDeaths", "class": "GameConnection", "params": {{out_set_deaths|event_params}} },
    { "name": "setKills", "class": "GameConnection", "params": {{out_set_kills|event_params}} },
    { "name": "joinTeam", "class": "GameConnection", "params": {{out_join_team|event_params}} },
    { "name": "incTimeRemaining", "class": "MiniGame", "params": {{out_inc_time|event_params}} },
    { "name": "setTimeRemaining", "class": "MiniGame", "params": {{out_set_time|event_params}} },
    { "name": "Win", "class": "MiniGame", "params": {{out_win|event_params}} },
    { "name": "checkTeam", "class": "fxDTSBrick", "params": {{out_check_team|event_params}} },
    { "name": "checkTeamCount", "class": "fxDTSBrick", "params": {{out_check_team_count|event_params}} },
    { "name": "StartFlyThrough", "class": "MiniGame", "params": {{out_fly_through|event_params}} }
  ],
  "commands": [
    {
      "name": "teams",
      "args": [
        "string"
      ],
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "slayer",
      "args": [
        "string"
      ],
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "jointeam",
      "args": [
        "string"
      ],
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "leaveteam",
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "listteams",
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "teamlist",
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "teamcount",
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "teamscore",
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "createflycam",
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "deleteflycam",
      "while_dead": true,
      "cooldown_ticks": 12
    },
    {
      "name": "setknot",
      "args": [
        "string"
      ],
      "while_dead": true,
      "cooldown_ticks": 6
    },
    {
      "name": "setjump",
      "args": [
        "string"
      ],
      "while_dead": true,
      "cooldown_ticks": 6
    },
    {
      "name": "testflycam",
      "while_dead": true,
      "cooldown_ticks": 12
    }
  ],
  "settings": [
    {
      "key": "mode",
      "title": "Game Mode",
      "category": "Minigame",
      "type": "list",
      "default": "{{dm_class}}",
      "items": [
        {
          "value": "{{dm_class}}",
          "name": "{{dm_name}}"
        },
        {
          "value": "{{tdm_class}}",
          "name": "{{tdm_name}}"
        }
      ]
    },
    {
      "key": "time_between_rounds",
      "title": "Time Between Rounds",
      "category": "Minigame",
      "type": "int",
      "default": {{pref_time_between_rounds}},
      "min": 5,
      "max": 300
    },
    {
      "key": "pre_round_seconds",
      "title": "Pre-Round Countdown",
      "category": "Minigame",
      "type": "int",
      "default": {{pref_pre_round}},
      "min": 0,
      "max": 10
    },
    {
      "key": "allow_move_while_resetting",
      "title": "Allow Movement During Reset",
      "category": "Minigame",
      "type": "bool",
      "default": {{pref_allow_move|bool}}
    },
    {
      "key": "clear_stats",
      "title": "Clear Stats on Reset",
      "category": "Minigame",
      "type": "bool",
      "default": {{pref_clear_stats|bool}}
    },
    {
      "key": "custom_rule",
      "title": "Custom Rule",
      "category": "Minigame",
      "type": "text",
      "default": "",
      "max_length": 150
    },
    {
      "key": "lives",
      "title": "Lives",
      "category": "Victory Method",
      "type": "int",
      "default": {{pref_lives}},
      "min": 0,
      "max": 99
    },
    {
      "key": "points",
      "title": "Points",
      "category": "Victory Method",
      "type": "int",
      "default": {{pref_points}},
      "min": 0,
      "max": 2000
    },
    {
      "key": "time",
      "title": "Time",
      "category": "Victory Method",
      "type": "int",
      "default": {{pref_time}},
      "min": 0,
      "max": 999999
    },
    {
      "key": "points_cp",
      "title": "CP Capture",
      "category": "Points",
      "type": "int",
      "default": {{pref_points_cp}},
      "min": -999,
      "max": 999
    },
    {
      "key": "cp_tick_ms",
      "title": "Tick Time",
      "category": "Capture Points",
      "type": "int",
      "default": {{pref_cp_tick}},
      "min": 20,
      "max": 500
    },
    {
      "key": "cp_transition_colors",
      "title": "Use Transitional Colors",
      "category": "Capture Points",
      "type": "bool",
      "default": {{pref_cp_transition|bool}}
    },
    {
      "key": "auto_sort",
      "title": "Auto Sort",
      "category": "Teams",
      "type": "bool",
      "default": {{pref_auto_sort|bool}}
    },
    {
      "key": "balance_new_teams",
      "title": "Balance New Teams",
      "category": "Teams",
      "type": "bool",
      "default": {{pref_balance_new|bool}},
      "editor": "admin"
    },
    {
      "key": "notify_member_changes",
      "title": "Display Join/Leave Messages",
      "category": "Teams",
      "type": "bool",
      "default": {{pref_notify|bool}}
    },
    {
      "key": "friendly_fire",
      "title": "Friendly Fire",
      "category": "Teams",
      "type": "bool",
      "default": {{pref_friendly_fire|bool}}
    },
    {
      "key": "lock_teams",
      "title": "Lock Teams",
      "category": "Teams",
      "type": "bool",
      "default": {{pref_lock|bool}}
    },
    {
      "key": "ally_same_colors",
      "title": "Ally Same Colors",
      "category": "Teams",
      "type": "bool",
      "default": {{pref_ally|bool}}
    },
    {
      "key": "team_only_dead_cam",
      "title": "Team-Only DeadCam",
      "category": "Teams",
      "type": "bool",
      "default": {{pref_team_only_dead_cam|bool}}
    },
    {
      "key": "spectate_auto_cam",
      "title": "Enable Auto-Camera Mode",
      "category": "Spectators",
      "type": "bool",
      "default": {{pref_spectate_auto_cam|bool}}
    },
    {
      "key": "spectate_cps",
      "title": "Spectate Capture Points",
      "category": "Spectators",
      "type": "bool",
      "default": {{pref_spectate_cps|bool}}
    },
    {
      "key": "fly_play_on_reset",
      "title": "Play At Beginning of Round",
      "category": "Fly-Through Cam",
      "type": "bool",
      "default": {{fly_play_on_reset|bool}}
    },
    {
      "key": "fly_during_countdown",
      "title": "Countdown During Fly-Thru",
      "category": "Fly-Through Cam",
      "type": "bool",
      "default": {{fly_during_countdown|bool}}
    },
    {
      "key": "fly_rounds_between",
      "title": "Rounds Between Fly-Thrus",
      "category": "Fly-Through Cam",
      "type": "bool",
      "default": {{fly_rounds_between|bool}}
    },
    {
      "key": "team_lives",
      "title": "Lives",
      "category": "Team",
      "type": "int",
      "default": {{team_lives}},
      "scope": "team",
      "min": -1,
      "max": 999
    },
    {
      "key": "team_sort",
      "title": "Auto Sort",
      "category": "Team",
      "type": "bool",
      "default": {{team_sort|bool}},
      "scope": "team"
    },
    {
      "key": "team_sort_weight",
      "title": "Auto Sort Weight",
      "category": "Team",
      "type": "int",
      "default": {{team_sort_weight}},
      "scope": "team",
      "min": 0,
      "max": 99
    },
    {
      "key": "team_max_players",
      "title": "Max Players",
      "category": "Team",
      "type": "int",
      "default": {{team_max_players}},
      "scope": "team",
      "min": -1,
      "max": 99
    },
    {
      "key": "team_lock",
      "title": "Lock Team",
      "category": "Team",
      "type": "bool",
      "default": {{team_lock|bool}},
      "scope": "team"
    },
    {
      "key": "team_win_on_time_up",
      "title": "Win on Time Up",
      "category": "Team",
      "type": "bool",
      "default": {{team_win_on_time_up|bool}},
      "scope": "team"
    }
  ],
  "state": {
    "global": {
      "games": {
        "default": {},
        "persist": false
      },
      "wins": {
        "default": {},
        "persist": false
      },
      "cps": {
        "default": {},
        "persist": false
      },
      "flycams": {
        "default": {},
        "persist": false
      },
      "controls": {
        "default": {},
        "persist": false
      }
    },
    "player": {
      "lives": {
        "default": 0,
        "persist": false
      },
      "out": {
        "default": false,
        "persist": false
      },
      "wins": {
        "default": 0,
        "persist": false
      },
      "spec": {
        "default": {},
        "persist": false
      },
      "body": {
        "default": "",
        "persist": false
      },
      "kills": {
        "default": 0,
        "persist": false,
        "visible": "everyone"
      },
      "deaths": {
        "default": 0,
        "persist": false,
        "visible": "everyone"
      },
      "reason": {
        "default": "",
        "persist": false
      }
    }
  },
  "on_minigame": true,
  "on_pick_spawn": true,
  "on_death": true,
  "on_spawn": true,
  "on_path_node": true,
  "on_observer": true,
  "zones": [
    {
      "bricks": [
        "{{namespace}}:brick/brickslyrcpdata",
        "{{namespace}}:brick/brickslyrlrgcpdata"
      ],
      "above": 0.2,
      "period_ms": {{pref_cp_tick}},
      "ticks": true
    }
  ],
  "tick_interval": 12
}
