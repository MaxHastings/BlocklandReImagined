        "max_reserve": 200,
        "display": ".50 Caliber"
      }
    },
    "every": {
      "reload_state": "onReloaded",
      "light_states": [
        "Ready",
        "Empty",
        "EmptyFire"
      ],
      "checks": {
        "TT_onLoadCheck": {
          "loaded": [
            "shot"
          ],
          "ammo": [
            "reserve"
          ]
        },
        "TT_onFireCheck": {
          "loaded": [
            "shot"
          ],
          "ammo": [
            "reserve"
          ]
        },
        "TT_onReloadCheck": {
          "loaded": [
            "full",
            "no_reserve"
          ],
          "ammo": [
            "reserve"
          ]
        },
        "TT_onDeathCheck": {
          "ammo": true
        }
      },
      "on_reload": {
        "loaded": false,
        "ammo": [
          "empty"
        ]
      },
      "display_ticks": 480,
      "display_scripts": [
        "TT_onEmptyFire"
      ],
      "on_loaded": {
        "loaded": true
      }
    },
    "counted": {
      "field": "TT_grenade"
    }
  },
  "scripts": [
    {
      "method": "*",
      "into": "shot",
      "pattern": "%spread\\s*=\\s*(?P<spread>[\\d.]+)\\s*;",
      "set": {
        "spread": "{spread}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "%shellCount\\s*=\\s*(?P<n>\\d+)\\s*;",
      "set": {
        "projectiles": "{n}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "vectorLen\\(\\s*%obj\\.getVelocity\\(\\s*\\)\\s*\\)\\s*<\\s*(?P<speed>[\\d.]+)\\s*\\)\\s*\\{\\s*%spread\\s*=\\s*(?P<still>[\\d.]+)\\s*;\\s*\\}\\s*else\\s*\\{\\s*%spread\\s*=\\s*(?P<moving>[\\d.]+)\\s*;",
      "set": {
        "spread": "{still}",
        "moving_spread": "{moving}",
        "moving_speed": "{speed}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "vectorLen\\(\\s*%obj\\.getVelocity\\(\\s*\\)\\s*\\)\\s*>\\s*(?P<speed>[\\d.]+)\\s*\\)\\s*\\{\\s*%spread\\s*=\\s*(?P<moving>[\\d.]+)\\s*;\\s*\\}\\s*else\\s*\\{\\s*%spread\\s*=\\s*(?P<still>[\\d.]+)\\s*;",
      "set": {
        "spread": "{still}",
        "moving_spread": "{moving}",
        "moving_speed": "{speed}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "vectorLen\\(\\s*%obj\\.getVelocity\\(\\s*\\)\\s*\\)\\s*>\\s*(?P<speed>[\\d.]+)\\s*\\)\\s*\\{\\s*%this\\.TT_raycastSpreadAmt\\s*=\\s*(?P<moving>[\\d.]+)\\s*;\\s*%this\\.TT_raycastWeaponRange\\s*=\\s*(?P<moving_range>[\\d.]+)\\s*;\\s*\\}\\s*else\\s*\\{\\s*%this\\.TT_raycastSpreadAmt\\s*=\\s*(?P<still>[\\d.]+)\\s*;\\s*%this\\.TT_raycastWeaponRange\\s*=\\s*(?P<range>[\\d.]+)\\s*;",
      "required_by": "%this\\.TT_raycastSpreadAmt\\s*=",
      "set": {
        "spread": "{still}",
        "moving_spread": "{moving}",
        "moving_speed": "{speed}",
        "hitscan": {
          "range": "{range}",
          "moving_range": "{moving_range}"
        }
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "vectorLen\\(\\s*%obj\\.getVelocity\\(\\s*\\)\\s*\\)\\s*<\\s*(?P<speed>[\\d.]+)[^{]*\\{\\s*%projectile\\s*=\\s*%this\\.projectile\\s*;\\s*%spread\\s*=\\s*(?P<still>[\\d.]+)\\s*;\\s*\\}\\s*else\\s*\\{\\s*%projectile\\s*=\\s*(?P<weak>\\w+)\\s*;\\s*%spread\\s*=\\s*(?P<moving>[\\d.]+)\\s*;",
      "set": {
        "spread": "{still}",
        "moving_spread": "{moving}",
        "moving_speed": "{speed}",
        "moving_projectile": "{weak|projectile}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "\\(\\s*getSimTime\\(\\s*\\)\\s*-\\s*%obj\\.lastShotTime\\s*\\)\\s*>\\s*(?P<ms>\\d+)\\s*\\)\\s*\\{\\s*%projectile\\s*=\\s*(?P<rested_projectile>\\w+)\\s*;\\s*%spread\\s*=\\s*(?P<rested>[\\d.]+)\\s*;\\s*\\}\\s*else\\s*\\{\\s*%projectile\\s*=\\s*%this\\.projectile\\s*;\\s*%spread\\s*=\\s*(?P<spread>[\\d.]+)\\s*;[\\s\\S]*%obj\\.lastShotTime\\s*=\\s*getSimTime\\(",
      "required_by": "getSimTime\\(\\s*\\)\\s*-\\s*%obj\\.lastShotTime\\s*\\)\\s*>\\s*\\d+\\s*\\)\\s*\\{\\s*%projectile\\s*=\\s*[A-Za-z_][\\s\\S]*%obj\\.lastShotTime\\s*=\\s*getSimTime\\(",
      "set": {
        "spread": "{spread}",
        "rested": {
          "after_ticks": "{ms|ticks}",
          "spread": "{rested}",
          "projectile": "{rested_projectile|projectile}"
        }
      }
    },
    {
      "method": "onFire",
      "into": "magazine",
      "pattern": "TT_canFire\\(\\s*%obj\\s*,\\s*(?P<n>\\d+)\\s*\\)",
      "set": {
        "per_shot": "{n}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "TT_createProjectile\\(",
      "set": {
        "free": true
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "(?s)TT_createProjectile\\(.*TT_decrementAmmo\\(|TT_decrementAmmo\\(.*TT_createProjectile\\(",
      "set": {
        "free": false
      }
    },
    {
      "method": "*",
      "into": "check",
      "pattern": "TT_canFire\\(\\s*%obj\\s*\\)\\s*\\)\\s*\\{\\s*%obj\\.setImageLoaded\\(\\s*%slot\\s*,\\s*1\\s*\\)\\s*;\\s*%this\\.TT_decrementAmmo\\(",
      "set": {
        "loaded": [
          "shot"
        ],
        "spend": true
      }
    },
    {
      "method": "TT_onLoadCheck",
      "into": "check",
      "pattern": "if\\s*\\(\\s*%obj\\.TT_forceToolReload\\s*\\|\\|\\s*%this\\.TT_needsAmmo\\(\\s*%obj\\s*\\)\\s*\\)\\s*%obj\\.setImageLoaded\\(\\s*%slot\\s*,\\s*0\\s*\\)",
      "required_by": "TT_forceToolReload",
      "set": {
        "keeps_reload": true
      }
    },
    {
      "method": "*|onMount",
      "into": "table",
      "table": "laid",
      "pattern": "pushDatablock\\(\\s*(?P<a>\\w+)\\.getID\\(\\s*\\)\\s*\\)",
      "set": {
        "archetype": "{a|archetype}"
      }
    },
    {
      "method": "onAltTrigger",
      "into": "table",
      "table": "alt_images",
      "pattern": "mountImage\\(\\s*(?P<i>\\w+)\\s*,\\s*0\\s*\\)",
      "required_by": "mountImage\\(",
      "set": {
        "image": "{i|image}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "spawnExplosion\\(\\s*(?P<p>\\w+)\\s*,",
      "set": {
        "kick": "{p|kick}"
      }
    },
    {
      "method": "*",
      "into": "shot",
      "pattern": "TT_knockback\\(\\s*%obj\\s*,\\s*(?P<h>-?[\\d.]+)\\s*,\\s*-?[\\d.]+\\s*,\\s*(?P<v>-?[\\d.]+)\\s*\\)",
      "required_by": "TT_knockback\\(",
      "set": {
        "recoil": "{h|neg}",
        "recoil_vertical": "{v|neg}"
      }
    },
    {
      "method": "onFire",
      "into": "image",
      "pattern": "TT_createProjectile\\(\\s*%this\\s*,\\s*%obj\\s*,\\s*%slot\\s*,\\s*(?P<p>[A-Za-z_]\\w*)\\s*,\\s*(?P<n>\\d+)\\s*\\)",
      "set": {
        "volleys": [
          {
            "projectile": "{p|projectile}",
            "projectiles": "{n}",
            "spread": 0
          }
        ]
      }
    },
    {
      "method": "onFire",
      "into": "image",
      "pattern": "%projectile\\s*=\\s*(?P<p>[A-Za-z_]\\w*)\\s*;\\s*%spread\\s*=\\s*(?P<s>[\\d.]+)\\s*;\\s*%shellcount\\s*=\\s*(?P<n>\\d+)\\s*;\\s*TT_createProjectile\\(\\s*%this\\s*,\\s*%obj\\s*,\\s*%slot\\s*,\\s*%projectile\\s*,\\s*%shellCount\\s*,\\s*%spread\\s*\\)",
      "set": {
        "volleys": [
          {
            "projectile": "{p|projectile}",
            "projectiles": "{n}",
            "spread": "{s}"
          }
        ]
      }
    },
    {
      "method": "onMount",
      "into": "image",
      "pattern": "%obj\\.mountImage\\(\\s*(?P<i>\\w+)\\s*,\\s*1\\s*\\)",
      "set": {
        "left_image": "{i|image}"
      }
    },
    {
      "method": "onFire",
      "into": "magazine",
      "pattern": "TT_canFire\\([^)]*\\)\\s*\\)[\\s\\S]*\\}\\s*else[^{]*\\{\\s*serverPlay3D\\(\\s*(?P<s>\\w+)\\s*,",
      "set": {
        "empty_sound": "{s|sound}"
      }
    },
    {
      "method": "*",
      "into": "state",
      "keep": true,
      "pattern": "TT_reload\\(\\s*%obj\\s*,\\s*%slot\\s*,\\s*(?P<s>\\w+)\\s*,\\s*(?P<a>\\w+)\\s*\\)",
      "set": {
        "sound": "{s|sound}",
        "arm": "{a}"
      }
    },
    {
      "method": "*",
      "into": "state",
      "keep": true,
      "pattern": "TT_reload\\(\\s*%obj\\s*,\\s*%slot\\s*,\\s*(?P<s>\\w+)\\s*\\)",
      "set": {
        "sound": "{s|sound}"
      }
    },
    {
      "method": "*",
      "into": "magazine",
      "pattern": "TT_incrementReload\\(\\s*%obj\\s*,\\s*%slot\\b",
      "set": {
        "one_by_one": true,
        "on_loaded": null
      }
    },
    {
      "method": "*",
      "into": "state",
      "keep": true,
      "pattern": "TT_incrementReload\\(\\s*%obj\\s*,\\s*%slot\\s*,\\s*[\\d\\s]*,\\s*(?P<s>\\w+)\\s*,\\s*(?P<a>\\w+)\\s*\\)",
      "set": {
        "sound": "{s|sound}",
        "arm": "{a}"
      }
    },
    {
      "on": "projectile",
      "method": "damage",
      "into": "projectile",
      "pattern": "TT_dampenVelocity\\(\\s*%col\\s*,\\s*(?P<d>[\\d.]+)\\s*\\)",
      "set": {
        "slow": {
          "divisor": "{d}"
        }
      }
    },
    {
      "on": "projectile",
      "method": "damage",
      "into": "table",
      "table": "headshots",
      "pattern": "TT_processHeadshotDamage\\([^;]*?,\\s*(?P<m>[\\d.]+|%\\w+)\\s*,\\s*\\$DamageType::(?P<t>\\w+)\\s*\\)",
      "set": {
        "multiplier": "{m}",
        "type": "{t}"
      },
      "required_by": "TT_processHeadshotDamage\\("
    },
    {
      "on": "projectile",
      "method": "damage",
      "into": "table",
      "table": "headshots",
      "pattern": "%multiplier\\s*=\\s*(?P<m>[\\d.]+)\\s*;[\\s\\S]*TT_processHeadshotDamage\\([^;]*,\\s*%multiplier\\s*,\\s*\\$DamageType::(?P<t>\\w+)\\s*\\)",
      "set": {
        "multiplier": "{m}"
      }
    },
    {
      "method": "TT_isRaycastCritical",
      "into": "table",
      "table": "crit_images",
      "pattern": "return\\s+TT_isRaycastHeadshot\\(",
      "required_by": "return",
      "set": {
        "headshot": true
      }
    },
    {
      "on": "item",
      "method": "onAdd",
      "into": "item",
      "pattern": "setShapeName\\(\\s*getWord\\(\\s*(?P<f>%obj\\.TT_ammoPickup\\[0\\])\\s*,\\s*1\\s*\\)\\s*\\)",
      "set": {
        "label": "{f|field|word1|text}"
      },
      "required_by": "setShapeName\\("
    },
    {
      "on": "item",
      "method": "onAdd",
      "into": "item",
      "pattern": "%obj\\.rotate\\s*=\\s*(true|1)\\s*;",
      "set": {
        "rotate": true
      }
    },
    {
      "method": "onMount",
      "into": "image",
      "pattern": "playThread\\(\\s*[12]\\s*,\\s*\"?armreadyboth\"?\\s*\\)",
      "set": {
        "both_arms": true
      }
    }
  ],
  "rules": {
    "capabilities": [
      "player",
      "damage",
      "effects"
    ],
    "tables": {
      "ammo_items": {
        "class": "ItemData",
        "fields": [
          "TT_pickupSound",
          "TT_ammoPickup[0]",
          "TT_ammoPickup[1]",
          "TT_ammoPickup[2]",
          "TT_ammoPickup[3]",
          "TT_ammoPickup[4]",
          "TT_ammoPickup[5]",
          "TT_ammoPickup[6]",
          "TT_ammoPickup[7]",
          "TT_ammoPickup[8]",
          "TT_ammoPickup[9]",
          "TT_ammoPickup[10]",
          "TT_ammoPickup[11]"
        ],
        "when": [
          "TT_ammoPickup"
        ],
        "key": "id"
      },
      "registered": {
        "call": "TT_registerAmmoType",
        "fields": [
          "type",
          "",
          "",
          "can_drop",
          "set0",
          "set1",
          "set2",
          "set3"
        ],
        "key": "type"
      },
      "crit_types": {
        "class": "ShapeBaseImageData",
        "fields": [
          "TT_raycastCritDirectDamageType"
        ],
        "when": [
          "TT_raycastCritDirectDamageType"
        ],
        "key": "id"
      }
    },
    "values": {
      "critical": "{uses:Emote_Critical}"
    },
    "uses": [
      "Emote_Critical"
    ]
  }
}
