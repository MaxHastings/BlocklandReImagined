      "port": "tool_grapplerope",
      "status": "verified",
      "sha256": [
        "456a082bb30c498ed08d1771edbde8697e37a036077b5a20b68c446c1395fa19"
      ],
      "covers": {
        "GrappleRopeProjectile::onCollision": {
          "lift": "vectoradd\\s*\\(\\s*%ppos\\s*,\\s*\\\"0 0 ([0-9]*\\.?[0-9]+)\\\"",
          "length": "ropelength\\s*=\\s*vectorlen\\s*\\(\\s*vectorsub"
        },
        "GrappleRopeImage::onHold": {
          "rope": "grapplerope\\s*\\(",
          "chain": "datablock\\s*=\\s*chainprojectile\\s*;",
          "speed": "vectorscale\\s*\\(\\s*%norm\\s*,\\s*([0-9]*\\.?[0-9]+)\\s*\\)"
        },
        "GrappleRopeImage::onRelease": {
          "release": "grappleropepos\\s*=\\s*\\\"\\\""
        },
        "GrappleRope": {
          "swing": "setvelocity\\s*\\(\\s*%vel\\s*\\)"
        }
      },
      "tests": [
        "tool_grapplerope/checks.json",
        "crates/addon-import/tests/grapples.rs the_grapple_rope_hangs_its_holder_where_the_hook_strikes",
        "crates/addon-import/tests/grapples.rs a_rope_is_as_long_as_the_hook_reaches",
        "crates/client/tests/weapon_effects.rs held_ropes_lay_their_trail_along_the_rope"
      ]
    },
    {
      "addon": "Weapon_Loz_Hookshot",
