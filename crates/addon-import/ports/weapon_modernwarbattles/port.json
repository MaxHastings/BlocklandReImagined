{
  "schema_version": 1,
  "notes": "Bushido's Adventurer's Weapons on the hl2 ammo system: each gun's maxmag and ammotype become its image's magazine, with the original's reserve and cap per ammo type and the reload its own states play (a shell at a time for the guns that load one). Each onFire's spread code becomes its shot (the Hunting Shotgun's blast as a second volley), and the Revolver, Battle Rifle, Sniper Rifle, Baton and Machete are hitscan from their raycast fields. The frag grenade throws its cluster shrapnel and its smoke trails as it explodes, each set as fast on average as the script's random throw (its shrapnel hurts by the cluster's own blast; the script's ShrapProjectile damage belongs to no datablock, so it never ran). The host rules, shared with the Glass 1019 release, give ammo boxes (a typed box adds twice its amount for each gun of its type, as the original does) and spare spawned guns their ammo, multiply a projectile's damage by its headshotMultiplier on a head hit or a crouched target, give the hitscan guns their crits (×3) and shoves, and make the melee swings kill outright. Not yet ported: the Heavy Machine Gun's second and third fire states, and the melee swings' vehicle kills; crit hit effects and sounds are not played.",
  "patch": {
    "assets/weapons.json": {
      "projectiles": {
        "{namespace}:projectile/shrapgrenprojectile": {
          "children": [
            {
              "projectile": "{namespace}:projectile/shrapgrenclusterprojectile",
              "count": "{shrap_count}",
              "speed": 20.5,
              "on_explode": true
            },
            {
              "projectile": "{namespace}:projectile/shrapgrentrailprojectile",
              "count": "{trail_count}",
              "speed": 39.3,
              "on_explode": true
            }
          ]
        }
      }
    }
  },
  "magazines": {
    "size": "maxmag",
    "ammo": "ammotype",
    "reload_ticks": 120,
    "one_by_one": "onReloadSingle",
    "types": {
      "Pistol": {
        "ammo": "pistol",
        "reserve": 32,
        "max_reserve": 64
      },
      "Revolver": {
        "ammo": "revolver",
        "reserve": 12,
        "max_reserve": 60
      },
      "Machine Pistol": {
        "ammo": "machine-pistol",
        "reserve": 72,
        "max_reserve": 320
      },
      "Light Machine Gun": {
        "ammo": "light-machine-gun",
        "reserve": 72,
        "max_reserve": 320
      },
      "Heavy Machine Gun": {
        "ammo": "heavy-machine-gun",
        "reserve": 144,
        "max_reserve": 320
      },
      "Shotgun": {
        "ammo": "shotgun",
        "reserve": 12,
        "max_reserve": 64
      },
      "Rifle": {
        "ammo": "rifle",
        "reserve": 16,
        "max_reserve": 128
      },
      "Sniper Rifle": {
        "ammo": "sniper-rifle",
        "reserve": 6,
        "max_reserve": 12
      },
      "Machine Rifle": {
        "ammo": "machine-rifle",
        "reserve": 64,
        "max_reserve": 128
      },
      "Frag Grenades": {
        "ammo": "frag-grenades",
        "reserve": 1,
        "max_reserve": 5
      }
    }
  },
  "shots": {},
  "hitscans": {
    "when": "raycastWeaponRange",
    "range": "raycastWeaponRange",
    "from_muzzle": "raycastFromMuzzle",
    "damage": "raycastDirectDamage",
    "damage_limit": 100.0,
    "damage_type": "raycastDirectDamageType",
    "hit_projectile": "raycastExplosionProjectile",
    "impulse": "raycastImpactImpulse",
    "vertical": "raycastVerticalImpulse",
    "count": "raycastSpreadCount",
    "spread": "raycastSpreadAmt",
    "tracer": {
      "field": "raycastTracerProjectile",
      "look": {
        "color": [
          1.0,
          0.95,
          0.75,
          0.7
        ],
        "width": 0.04,
        "seconds": 0.08
      }
    }
  },
  "rules": {
    "capabilities": [
      "player",
      "damage",
      "physics"
    ],
    "tables": {
      "headshots": {
        "class": "ProjectileData",
        "fields": [
          "headshotMultiplier"
        ],
        "when": [
          "headshotMultiplier"
        ],
        "key": "id"
      },
      "boxes": {
        "class": "ItemData",
        "fields": [
          "ammotype"
        ],
        "when": [
          "ammoBox"
        ],
        "key": "id"
      }
    },
    "values": {
      "each_gun": true,
      "rays": {
        "{namespace}:projectile/revolverimageray": {
          "crit": true,
          "kill": null,
          "shove": "{revolver_shove}",
          "up": "{revolver_up}"
        },
        "{namespace}:projectile/battlerifleimageray": {
          "crit": true,
          "kill": null,
          "shove": "{battlerifle_shove}",
          "up": "{battlerifle_up}"
        },
        "{namespace}:projectile/sniperrifleimageray": {
          "crit": true,
          "kill": null,
          "shove": "{sniperrifle_shove}",
          "up": "{sniperrifle_up}"
        },
        "{namespace}:projectile/batonimageray": {
          "crit": false,
          "kill": "{baton_kill}",
          "shove": "{baton_shove}",
          "up": "{baton_up}"
        },
        "{namespace}:projectile/macheteimageray": {
          "crit": false,
          "kill": "{machete_kill}",
          "shove": "{machete_shove}",
          "up": "{machete_up}"
        }
      },
      "tasers": {}
    }
  }
}
