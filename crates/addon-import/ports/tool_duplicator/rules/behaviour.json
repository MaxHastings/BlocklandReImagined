{
  "schema_version": 1,
  "script": "duplorcator.rhai",
  "commands": [
    { "name": "fire", "aim_reach": {{reach}}, "tool_only": true },
    { "name": "duplorcator" },
    { "name": "dup" },
    { "name": "duplicator" },
    { "name": "savedup", "args": ["string"] },
    { "name": "loaddup", "args": ["string"] },
    { "name": "duplorcatorloadanyways" },
    { "name": "mount", "tool_only": true },
    { "name": "unmount", "tool_only": true, "while_dead": true },
    { "name": "cancel", "tool_only": true },
    { "name": "clientload", "args": ["string"] },
    { "name": "reloaddup" }
  ],
  "on_copy": true,
  "on_place": true,
  "state": {
    "player": {
      "last_select": { "default": -1000000, "persist": false },
      "last_load": { "default": -1000000, "persist": false },
      "asked_load": { "default": "", "persist": false }
    }
  }
}
