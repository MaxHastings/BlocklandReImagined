+/// v20 applies thrust, lift and wing forces to every WheeledVehicle
+/// (`WheeledVehicle::updateForces` 0x5746a0); natively only `FlyingWheeled`
+/// runs them, so a wheeled Add-On that authors any of them flies.
+fn wheeled_flight_family(
+    family: bri_vehicles::schema::Family,
+    fields: &BTreeMap<String, String>,
+) -> bri_vehicles::schema::Family {
+    use bri_vehicles::schema::Family;
+    let flies = [
+        "forwardthrust",
+        "reversethrust",
+        "lift",
+        "horizontalsurfaceforce",
+        "verticalsurfaceforce",
+    ]
+    .iter()
+    .any(|k| {
+        fields
+            .get(*k)
+            .and_then(|v| literal(v).trim().parse::<f32>().ok())
+            .is_some_and(|v| v != 0.)
+    });
+    if family == Family::Wheeled && flies {
+        Family::FlyingWheeled
+    } else {
+        family
+    }
+}
+/// `WheeledVehicleData::onAdd` in the recovered v20 core scripts: which wheels
+/// steer and which are powered, by wheel count (7+ repeats the 6 case).
+fn v20_default_wheels(wheels: &mut [bri_vehicles::schema::Wheel]) {
+    let (steer, first_powered) = match wheels.len() {
+        0 => return,
+        1 => (1, 0),
+        2 => (2, 0),
+        3 | 5 => (1, 1),
+        _ => (2, 2),
+    };
+    let last_powered = wheels.len().min(6);
+    for (i, w) in wheels.iter_mut().enumerate() {
+        w.steering = if i < steer { 1. } else { 0. };
+        w.powered = (first_powered..last_powered).contains(&i);
+    }
+}
+
+/// The chassis threads a vehicle's `onAdd` (and the helpers it calls) plays:
+/// `if (%speed < 5) playThread(0, slow); else playThread(0, fast);` with
+/// `%speed = vectorLen(%obj.getVelocity())` becomes slow from 0 and fast from
+/// 5; without such a choice, `onAdd`'s own `playThread` plays at any speed.
+fn speed_threads(
+    scripts: &[Script],
+    on_add: &tscript::Function,
+) -> Vec<bri_vehicles::schema::SpeedThread> {
+    use bri_vehicles::schema::SpeedThread;
+    fn compact(body: &str) -> String {
+        body.lines()
+            .map(|l| l.split("//").next().unwrap_or(""))
+            .flat_map(str::chars)
+            .filter(|c| !c.is_whitespace())
+            .flat_map(char::to_lowercase)
+            .collect()
+    }
+    // The `{...}` block or single statement starting at `at`, and where it ends.
+    fn segment(s: &str, at: usize) -> Option<(&str, usize)> {
+        if s[at..].starts_with('{') {
+            let mut depth = 0;
+            for (i, c) in s[at..].char_indices() {
+                match c {
+                    '{' => depth += 1,
+                    '}' => {
+                        depth -= 1;
+                        if depth == 0 {
+                            return Some((&s[at + 1..at + i], at + i + 1));
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            None
+        } else {
+            let end = at + s[at..].find(';')? + 1;
+            Some((&s[at..end], end))
+        }
+    }
+    fn sequences(s: &str) -> Vec<String> {
+        s.match_indices("playthread(")
+            .filter_map(|(i, m)| {
+                let args = &s[i + m.len()..];
+                let args = &args[..args.find(')')?];
+                let seq = args.split(',').nth(1)?.trim_matches('"');
+                (!seq.is_empty() && !seq.starts_with('%')).then(|| seq.to_owned())
+            })
+            .collect()
+    }
+    let direct = compact(&on_add.body);
+    let mut bodies = vec![direct.clone()];
+    for helper in scripts.iter().flat_map(|s| &s.functions).filter(|f| {
+        f.namespace.is_none()
+            && on_add
+                .calls
+                .iter()
+                .any(|c| c.receiver.is_none() && c.callee.eq_ignore_ascii_case(&f.name))
+    }) {
+        bodies.push(compact(&helper.body));
+    }
+    let mut threads: Vec<SpeedThread> = vec![];
+    fn add(threads: &mut Vec<SpeedThread>, sequence: String, min_speed: f32) {
+        if !threads.iter().any(|t| t.sequence == sequence) {
+            threads.push(SpeedThread { sequence, min_speed });
+        }
+    }
+    for body in &bodies {
+        let vars: Vec<&str> = body
+            .match_indices("=vectorlen(%obj.getvelocity());")
+            .filter_map(|(i, _)| body[..i].rsplit([';', '{', '}']).next())
+            .filter(|v| v.starts_with('%'))
+            .collect();
+        for var in vars {
+            let head = format!("if({var}");
+            for (i, _) in body.match_indices(&head) {
+                let rest = &body[i + head.len()..];
+                let Some((op, rest)) = ["<=", ">=", "<", ">"]
+                    .iter()
+                    .find_map(|op| rest.strip_prefix(op).map(|r| (*op, r)))
+                else {
+                    continue;
+                };
+                let Some(close) = rest.find(')') else { continue };
+                let Ok(limit) = rest[..close].parse::<f32>() else {
+                    continue;
+                };
+                let at = body.len() - rest.len() + close + 1;
+                let Some((then, end)) = segment(body, at) else {
+                    continue;
+                };
+                let otherwise = body[end..]
+                    .strip_prefix("else")
+                    .and_then(|_| segment(body, end + 4))
+                    .map_or("", |(s, _)| s);
+                let (below, above) = if op.starts_with('<') {
+                    (then, otherwise)
+                } else {
+                    (otherwise, then)
+                };
+                for s in sequences(below) {
+                    add(&mut threads, s, 0.);
+                }
+                for s in sequences(above) {
+                    add(&mut threads, s, limit);
+                }
+            }
+        }
+    }
+    if threads.is_empty() {
+        for s in sequences(&direct) {
+            add(&mut threads, s, 0.);
+        }
+    }
+    threads.sort_by(|a, b| a.min_speed.total_cmp(&b.min_speed));
+    threads
+}
