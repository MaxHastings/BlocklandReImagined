+//! Join codes for Blockland ReImagined: a small, self-hostable service that
+//! gives each host a short code, introduces players to hosts so both routers
+//! open for each other (UDP hole punching over QUIC), and relays the
+//! encrypted game traffic when that fails. See `docs/architecture/hosting.md`.
+pub mod natsim;
+pub mod proto;
+pub mod relay;
+pub mod service;
diff --git a/crates/rendezvous/src/natsim.rs b/crates/rendezvous/src/natsim.rs
new file mode 100644
index 0000000..4e97f50
--- /dev/null
+++ b/crates/rendezvous/src/natsim.rs
@@ -0,0 +1,325 @@
+//! Simulated home routers for headless tests of hole punching and relay.
+//!
+//! A [`NatSocket`] is a UDP socket "behind" a [`Nat`]: a QUIC endpoint uses
+//! it through quinn's `AsyncUdpSocket`, and every datagram it sends leaves
+//! from a real loopback socket on the NAT's public address (a mapping), as
+//! a router would rewrite it. Replies are let back in only as the NAT's
+//! filtering rule allows (RFC 4787 behaviours). Public addresses are
+//! loopback addresses such as 127.0.0.2, so no privileges or network
+//! namespaces are needed.
+use std::{
+    collections::{HashSet, VecDeque},
+    fmt,
+    io,
+    net::{IpAddr, Ipv4Addr, SocketAddr},
+    pin::Pin,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicU16, AtomicU64, Ordering},
+    },
+    task::{Context, Poll, Waker},
+};
+
+/// How a NAT picks the outside port for a new destination (RFC 4787 4.1).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Mapping {
+    /// One outside port per inside socket, whatever the destination (most
+    /// home routers).
+    EndpointIndependent,
+    /// A new outside port per destination ("symmetric" NAT, some carrier
+    /// and corporate NATs).
+    AddressAndPortDependent,
+}
+
+/// Which outside senders a mapping lets in (RFC 4787 5).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Filtering {
+    /// Anyone ("full cone").
+    EndpointIndependent,
+    /// Only IPs the inside socket has sent to.
+    AddressDependent,
+    /// Only exact addresses the inside socket has sent to.
+    AddressAndPortDependent,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Behaviour {
+    pub mapping: Mapping,
+    pub filtering: Filtering,
+}
+impl Behaviour {
+    pub const FULL_CONE: Self = Self {
+        mapping: Mapping::EndpointIndependent,
+        filtering: Filtering::EndpointIndependent,
+    };
+    /// The common home router.
+    pub const PORT_RESTRICTED: Self = Self {
+        mapping: Mapping::EndpointIndependent,
+        filtering: Filtering::AddressAndPortDependent,
+    };
+    pub const SYMMETRIC: Self = Self {
+        mapping: Mapping::AddressAndPortDependent,
+        filtering: Filtering::AddressAndPortDependent,
+    };
+}
+
+/// A router with one public address.
+#[derive(Debug)]
+pub struct Nat {
+    pub public_ip: IpAddr,
+    pub behaviour: Behaviour,
+    next_inside: AtomicU16,
+    /// Datagrams from outside that the filter refused.
+    pub filtered: AtomicU64,
+}
+impl Nat {
+    pub fn new(public_ip: IpAddr, behaviour: Behaviour) -> Arc<Self> {
+        Arc::new(Self {
+            public_ip,
+            behaviour,
+            next_inside: AtomicU16::new(40000),
+            filtered: AtomicU64::new(0),
+        })
+    }
+    /// A new socket inside this NAT.
+    pub fn socket(self: &Arc<Self>) -> Arc<NatSocket> {
+        let port = self.next_inside.fetch_add(1, Ordering::Relaxed);
+        Arc::new(NatSocket {
+            nat: self.clone(),
+            inside: SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 168, 1, 10)), port),
+            mappings: Mutex::new(Vec::new()),
+            inbox: Arc::new(Mutex::new(Inbox::default())),
+        })
+    }
+}
+
+#[derive(Default)]
+struct Inbox {
+    queue: VecDeque<(SocketAddr, Vec<u8>)>,
+    waker: Option<Waker>,
+}
+
+struct MappingEntry {
+    /// The destination this mapping is for, or None when shared by all.
+    destination: Option<SocketAddr>,
+    /// Sends go straight through the OS socket: a tokio socket reports
+    /// WouldBlock until its reactor has seen the socket writable once.
+    sender: Arc<std::net::UdpSocket>,
+    /// Addresses the inside socket has sent to through this mapping.
+    sent_to: Arc<Mutex<HashSet<SocketAddr>>>,
+    task: tokio::task::JoinHandle<()>,
+}
+impl Drop for MappingEntry {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+/// A UDP socket behind a simulated NAT, for `quinn::Endpoint::new_with_abstract_socket`.
+pub struct NatSocket {
+    nat: Arc<Nat>,
+    inside: SocketAddr,
+    mappings: Mutex<Vec<MappingEntry>>,
+    inbox: Arc<Mutex<Inbox>>,
+}
+impl fmt::Debug for NatSocket {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "NatSocket({} behind {})", self.inside, self.nat.public_ip)
+    }
+}
+
+impl NatSocket {
+    /// Outside addresses this socket has been given so far.
+    pub fn public_addresses(&self) -> Vec<SocketAddr> {
+        self.mappings
+            .lock()
+            .unwrap()
+            .iter()
+            .filter_map(|m| m.sender.local_addr().ok())
+            .collect()
+    }
+    fn mapping_for(&self, destination: SocketAddr) -> io::Result<(Arc<std::net::UdpSocket>, Arc<Mutex<HashSet<SocketAddr>>>)> {
+        let key = match self.nat.behaviour.mapping {
+            Mapping::EndpointIndependent => None,
+            Mapping::AddressAndPortDependent => Some(destination),
+        };
+        let mut mappings = self.mappings.lock().unwrap();
+        if let Some(entry) = mappings.iter().find(|m| m.destination == key) {
+            return Ok((entry.sender.clone(), entry.sent_to.clone()));
+        }
+        let std = std::net::UdpSocket::bind((self.nat.public_ip, 0))?;
+        std.set_nonblocking(true)?;
+        let sender = Arc::new(std.try_clone()?);
+        let socket = Arc::new(tokio::net::UdpSocket::from_std(std)?);
+        let sent_to = Arc::new(Mutex::new(HashSet::new()));
+        let task = tokio::spawn(receive(
+            socket.clone(),
+            sent_to.clone(),
+            self.nat.clone(),
+            self.inbox.clone(),
+        ));
+        mappings.push(MappingEntry {
+            destination: key,
+            sender: sender.clone(),
+            sent_to: sent_to.clone(),
+            task,
+        });
+        Ok((sender, sent_to))
+    }
+}
+
+/// Datagrams arriving at one mapping, let in by the NAT's filter.
+async fn receive(
+    socket: Arc<tokio::net::UdpSocket>,
+    sent_to: Arc<Mutex<HashSet<SocketAddr>>>,
+    nat: Arc<Nat>,
+    inbox: Arc<Mutex<Inbox>>,
+) {
+    let mut buffer = vec![0u8; 65536];
+    loop {
+        let (len, from) = match socket.recv_from(&mut buffer).await {
+            Ok(received) => received,
+            // An ICMP error from an earlier send; never spin on it.
+            Err(_) => {
+                tokio::time::sleep(std::time::Duration::from_millis(1)).await;
+                continue;
+            }
+        };
+        let allowed = {
+            let sent = sent_to.lock().unwrap();
+            match nat.behaviour.filtering {
+                Filtering::EndpointIndependent => true,
+                Filtering::AddressDependent => sent.iter().any(|a| a.ip() == from.ip()),
+                Filtering::AddressAndPortDependent => sent.contains(&from),
+            }
+        };
+        if !allowed {
+            nat.filtered.fetch_add(1, Ordering::Relaxed);
+            continue;
+        }
+        let mut inbox = inbox.lock().unwrap();
+        inbox.queue.push_back((from, buffer[..len].to_vec()));
+        if let Some(waker) = inbox.waker.take() {
+            waker.wake();
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Writable;
+impl quinn::UdpPoller for Writable {
+    fn poll_writable(self: Pin<&mut Self>, _cx: &mut Context) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl quinn::AsyncUdpSocket for NatSocket {
+    fn create_io_poller(self: Arc<Self>) -> Pin<Box<dyn quinn::UdpPoller>> {
+        Box::pin(Writable)
+    }
+    fn try_send(&self, transmit: &quinn::udp::Transmit) -> io::Result<()> {
+        let (socket, sent_to) = self.mapping_for(transmit.destination)?;
+        sent_to.lock().unwrap().insert(transmit.destination);
+        let segment = transmit.segment_size.unwrap_or(transmit.contents.len()).max(1);
+        for datagram in transmit.contents.chunks(segment) {
+            match socket.send_to(datagram, transmit.destination) {
+                Ok(_) => {}
+                // A full loopback buffer drops the datagram, like a network.
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => {}
+                Err(error) => return Err(error),
+            }
+        }
+        Ok(())
+    }
+    fn poll_recv(
+        &self,
+        cx: &mut Context,
+        bufs: &mut [io::IoSliceMut<'_>],
+        meta: &mut [quinn::udp::RecvMeta],
+    ) -> Poll<io::Result<usize>> {
+        let mut inbox = self.inbox.lock().unwrap();
+        let mut count = 0;
+        while count < bufs.len().min(meta.len()) {
+            let Some((from, datagram)) = inbox.queue.pop_front() else {
+                break;
+            };
+            let len = datagram.len().min(bufs[count].len());
+            bufs[count][..len].copy_from_slice(&datagram[..len]);
+            meta[count] = quinn::udp::RecvMeta {
+                addr: from,
+                len,
+                stride: len,
+                ecn: None,
+                dst_ip: None,
+            };
+            count += 1;
+        }
+        if count > 0 {
+            return Poll::Ready(Ok(count));
+        }
+        inbox.waker = Some(cx.waker().clone());
+        Poll::Pending
+    }
+    fn local_addr(&self) -> io::Result<SocketAddr> {
+        Ok(self.inside)
+    }
+    fn may_fragment(&self) -> bool {
+        false
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use quinn::AsyncUdpSocket;
+    fn transmit(to: SocketAddr, contents: &[u8]) -> quinn::udp::Transmit<'_> {
+        quinn::udp::Transmit {
+            destination: to,
+            ecn: None,
+            contents,
+            segment_size: None,
+            src_ip: None,
+        }
+    }
+    async fn next(socket: &NatSocket) -> Option<(SocketAddr, Vec<u8>)> {
+        for _ in 0..40 {
+            if let Some(item) = socket.inbox.lock().unwrap().queue.pop_front() {
+                return Some(item);
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        }
+        None
+    }
+    #[tokio::test]
+    async fn port_restricted_nats_admit_only_addresses_sent_to() {
+        let nat = Nat::new("127.0.0.2".parse().unwrap(), Behaviour::PORT_RESTRICTED);
+        let inside = nat.socket();
+        let friend = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let stranger = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let friend_at = friend.local_addr().unwrap();
+        inside.try_send(&transmit(friend_at, b"hi")).unwrap();
+        let mut buffer = [0u8; 16];
+        let (len, public) = friend.recv_from(&mut buffer).await.unwrap();
+        assert_eq!(&buffer[..len], b"hi");
+        assert_eq!(public.ip(), nat.public_ip, "the source is rewritten");
+        friend.send_to(b"back", public).await.unwrap();
+        stranger.send_to(b"sneak", public).await.unwrap();
+        assert_eq!(next(&inside).await, Some((friend_at, b"back".to_vec())));
+        assert_eq!(next(&inside).await, None);
+        assert_eq!(nat.filtered.load(Ordering::Relaxed), 1);
+    }
+    #[tokio::test]
+    async fn symmetric_nats_use_a_new_port_per_destination() {
+        let nat = Nat::new("127.0.0.3".parse().unwrap(), Behaviour::SYMMETRIC);
+        let inside = nat.socket();
+        let a = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let b = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        inside.try_send(&transmit(a.local_addr().unwrap(), b"x")).unwrap();
+        inside.try_send(&transmit(b.local_addr().unwrap(), b"x")).unwrap();
+        let mut buffer = [0u8; 4];
+        let (_, via_a) = a.recv_from(&mut buffer).await.unwrap();
+        let (_, via_b) = b.recv_from(&mut buffer).await.unwrap();
+        assert_ne!(via_a.port(), via_b.port());
+        assert_eq!(inside.public_addresses().len(), 2);
+    }
+}
diff --git a/crates/rendezvous/src/proto.rs b/crates/rendezvous/src/proto.rs
new file mode 100644
index 0000000..a080616
--- /dev/null
+++ b/crates/rendezvous/src/proto.rs
@@ -0,0 +1,248 @@
+//! What game clients and the rendezvous service say to each other, over one
+//! bidirectional QUIC stream per request. Frames are a little-endian `u32`
+//! length followed by that many bytes of JSON, at most [`MAX_FRAME`].
+use anyhow::{Context, Result, ensure};
+use serde::{Deserialize, Serialize, de::DeserializeOwned};
+use std::net::SocketAddr;
+
+/// Rendezvous protocol version, independent of the game protocol.
+pub const VERSION: u32 = 1;
+/// Default UDP port of the service.
+pub const DEFAULT_PORT: u16 = 28100;
+pub const MAX_FRAME: usize = 16 * 1024;
+/// Local addresses a peer may publish.
+pub const MAX_LOCALS: usize = 8;
+/// A host key: the first 16 bytes of the SHA-256 of its certificate.
+pub type Key = [u8; 16];
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub enum Request {
+    /// A host asks for a code. The stream stays open for as long as the host
+    /// wants the code; the service sends [`Answer::Joiner`] on it.
+    Host {
+        version: u32,
+        key: Key,
+        /// The host's addresses on its own network (same-network joiners).
+        locals: Vec<SocketAddr>,
+        name: String,
+    },
+    /// A player asks how to reach the host with this code.
+    Join {
+        version: u32,
+        code: String,
+        locals: Vec<SocketAddr>,
+    },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub enum Answer {
+    /// The host's code, and its game port's address as the service saw it.
+    Hosting { code: String, observed: SocketAddr },
+    /// Sent to the host: a player is about to connect. Send a packet to each
+    /// address from the game port so the router lets the player in.
+    Joiner {
+        observed: SocketAddr,
+        locals: Vec<SocketAddr>,
+        /// The relay port assigned to the host for this player.
+        relay: Option<SocketAddr>,
+    },
+    /// Sent to the player: where to try, in order, and whose key to expect.
+    Found {
+        key: Key,
+        name: String,
+        /// The host's public (observed) address, then its local ones.
+        candidates: Vec<SocketAddr>,
+        /// The relay port assigned to the player, if the service relays.
+        relay: Option<SocketAddr>,
+        observed: SocketAddr,
+    },
+    /// The request was refused; the text is for the player.
+    Refused(String),
+}
+
+pub async fn write<T: Serialize>(send: &mut quinn::SendStream, value: &T) -> Result<()> {
+    let bytes = serde_json::to_vec(value)?;
+    ensure!(bytes.len() <= MAX_FRAME, "Rendezvous frame too large");
+    send.write_all(&(bytes.len() as u32).to_le_bytes()).await?;
+    send.write_all(&bytes).await?;
+    Ok(())
+}
+
+/// Read one frame; `None` when the peer finished the stream.
+pub async fn read<T: DeserializeOwned>(receive: &mut quinn::RecvStream) -> Result<Option<T>> {
+    let mut length = [0u8; 4];
+    match receive.read_exact(&mut length).await {
+        Ok(()) => {}
+        Err(quinn::ReadExactError::FinishedEarly(0)) => return Ok(None),
+        Err(error) => return Err(error.into()),
+    }
+    let length = u32::from_le_bytes(length) as usize;
+    ensure!(length <= MAX_FRAME, "Rendezvous frame too large");
+    let mut bytes = vec![0; length];
+    receive.read_exact(&mut bytes).await?;
+    Ok(Some(serde_json::from_slice(&bytes).context("Malformed rendezvous frame")?))
+}
+
+/// Crockford base32: no I, L, O or U, so codes read aloud and type cleanly.
+const ALPHABET: &[u8; 32] = b"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+/// Characters in a code (30 bits); shown as `ABC-DEF`.
+pub const CODE_LEN: usize = 6;
+
+/// A fresh random code, formatted for display.
+pub fn new_code() -> Result<String> {
+    let mut bytes = [0u8; CODE_LEN];
+    getrandom::fill(&mut bytes).map_err(|e| anyhow::anyhow!("OS randomness failed: {e}"))?;
+    let raw: String = bytes.iter().map(|b| ALPHABET[(b & 31) as usize] as char).collect();
+    Ok(format!("{}-{}", &raw[..3], &raw[3..]))
+}
+
+/// A typed code in display form (`ABC-DEF`), or None when `text` is not a
+/// code. Case, a space instead of the dash, and the look-alikes O/I/L are
+/// forgiven. The dash (or space) is required, so a six-letter host name is
+/// never taken for a code.
+pub fn parse_code(text: &str) -> Option<String> {
+    let text = text.trim();
+    let bytes = text.as_bytes();
+    if bytes.len() != CODE_LEN + 1 || !matches!(bytes[3], b'-' | b' ') {
+        return None;
+    }
+    let mut code = String::with_capacity(CODE_LEN + 1);
+    for (i, &b) in bytes.iter().enumerate() {
+        if i == 3 {
+            code.push('-');
+            continue;
+        }
+        let c = match b.to_ascii_uppercase() {
+            b'O' => b'0',
+            b'I' | b'L' => b'1',
+            other => other,
+        };
+        if !ALPHABET.contains(&c) {
+            return None;
+        }
+        code.push(c as char);
+    }
+    Some(code)
+}
+
+/// The key of a certificate: the first 16 bytes of its SHA-256.
+pub fn key_of(certificate: &[u8]) -> Key {
+    use sha2::Digest;
+    let digest = sha2::Sha256::digest(certificate);
+    let mut key = [0; 16];
+    key.copy_from_slice(&digest[..16]);
+    key
+}
+
+/// RFC 4648 base32, lower case, unpadded: no characters that URLs, chat or
+/// fonts mangle, and case-insensitive when typed.
+const KEY_ALPHABET: &[u8; 32] = b"abcdefghijklmnopqrstuvwxyz234567";
+
+pub fn encode_key(key: &Key) -> String {
+    let mut out = String::new();
+    let (mut buffer, mut bits) = (0u32, 0);
+    for &byte in key {
+        buffer = (buffer << 8) | byte as u32;
+        bits += 8;
+        while bits >= 5 {
+            bits -= 5;
+            out.push(KEY_ALPHABET[((buffer >> bits) & 31) as usize] as char);
+        }
+    }
+    if bits > 0 {
+        out.push(KEY_ALPHABET[((buffer << (5 - bits)) & 31) as usize] as char);
+    }
+    out
+}
+
+pub fn decode_key(text: &str) -> Option<Key> {
+    (text.len() == 26).then_some(())?;
+    let mut bytes = Vec::with_capacity(16);
+    let (mut buffer, mut bits) = (0u32, 0);
+    for c in text.bytes() {
+        let value = KEY_ALPHABET
+            .iter()
+            .position(|&a| a == c.to_ascii_lowercase())? as u32;
+        buffer = (buffer << 5) | value;
+        bits += 5;
+        if bits >= 8 {
+            bits -= 8;
+            bytes.push((buffer >> bits) as u8);
+            buffer &= (1 << bits) - 1;
+        }
+    }
+    // Exactly the key, with no stray trailing bits.
+    (buffer == 0).then_some(())?;
+    bytes.try_into().ok()
+}
+
+/// Where a game finds the service and the key it must present:
+/// `host[:port]/key`, as printed by `bri-rendezvous` and set in the game's
+/// `$pref::Net::JoinCodeService`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ServiceAddress {
+    pub host: String,
+    pub port: u16,
+    pub key: Key,
+}
+impl ServiceAddress {
+    pub fn parse(text: &str) -> Result<Self> {
+        let text = text.trim();
+        let (address, key) = text
+            .rsplit_once('/')
+            .context("A join code service address looks like host:28100/key")?;
+        let key = decode_key(key).context("The join code service key is not valid")?;
+        let (host, port) = match address.rsplit_once(':') {
+            Some((host, port)) if !host.ends_with(':') => {
+                (host, port.parse().context("Invalid join code service port")?)
+            }
+            _ => (address, DEFAULT_PORT),
+        };
+        let host = host.trim_start_matches('[').trim_end_matches(']');
+        ensure!(!host.is_empty(), "A join code service address needs a host");
+        Ok(Self {
+            host: host.to_ascii_lowercase(),
+            port,
+            key,
+        })
+    }
+}
+impl std::fmt::Display for ServiceAddress {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        if self.host.contains(':') {
+            write!(f, "[{}]:{}/{}", self.host, self.port, encode_key(&self.key))
+        } else {
+            write!(f, "{}:{}/{}", self.host, self.port, encode_key(&self.key))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn service_addresses_round_trip() {
+        let key = key_of(b"cert");
+        let text = format!("Codes.Example.com:28100/{}", encode_key(&key));
+        let address = ServiceAddress::parse(&text).unwrap();
+        assert_eq!((address.host.as_str(), address.port, address.key), ("codes.example.com", 28100, key));
+        assert_eq!(ServiceAddress::parse(&address.to_string()).unwrap(), address);
+        let bare = ServiceAddress::parse(&format!("203.0.113.5/{}", encode_key(&key))).unwrap();
+        assert_eq!(bare.port, DEFAULT_PORT);
+        assert!(ServiceAddress::parse("codes.example.com:28100").is_err());
+        assert!(ServiceAddress::parse("codes.example.com:28100/short").is_err());
+    }
+    #[test]
+    fn codes_are_forgiving_to_type_and_never_host_names() {
+        let code = new_code().unwrap();
+        assert_eq!(code.len(), 7);
+        assert_eq!(parse_code(&code.to_ascii_lowercase()), Some(code.clone()));
+        assert_eq!(parse_code(" k7q 4mz "), Some("K7Q-4MZ".into()));
+        assert_eq!(parse_code("oil-abc"), Some("011-ABC".into()));
+        for not_a_code in ["k7q4mz", "server", "k7q-4m", "k7q-4mzz", "k7q-4mu", "play.example.com", "k7q_4mz"] {
+            assert_eq!(parse_code(not_a_code), None, "{not_a_code}");
+        }
+    }
+}
